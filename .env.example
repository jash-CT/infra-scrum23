# Local tooling environment variables
# Copy to .env and adjust values for your workstation

# Grafana local stack (docker-compose)
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=changeme

# Alertmanager notification channels (optional for local validation)
SLACK_WEBHOOK_URL=
PAGERDUTY_SERVICE_KEY=

# AWS CLI profile for Terraform operations
AWS_PROFILE=transactedge-dev
AWS_REGION=us-east-1

# Terraform
TF_VAR_acm_certificate_arn=arn:aws:acm:us-east-1:000000000000:certificate/00000000-0000-0000-0000-000000000000

# Kubernetes context
KUBECONFIG=~/.kube/config
EKS_CLUSTER_NAME=te-dev-eks
